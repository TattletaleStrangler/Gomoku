<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The offline game needs no permission at all; online play adds exactly one:
        INTERNET (TZ §11.1). The refresh token lives in its own preferences file and
        is excluded from backup, so it never leaves the device through the cloud
        (see res/xml/data_extraction_rules.xml and res/xml/backup_rules.xml).
        localeConfig feeds the Android 13+ per-app language picker; older versions
        ignore the attribute, which is what tools:targetApi records for lint.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GomokuApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gomoku"
        tools:targetApi="33">

        <!-- Orientation is intentionally NOT locked: Android 16+ ignores a fixed
             orientation on large screens, and a square board adapts fine. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/history_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.CrashLogActivity"
            android:exported="false"
            android:label="@string/crash_log"
            android:parentActivityName=".MainActivity" />

        <!-- Online play (TZ §11.4). The account screen is the entry point; the room
             screen and the game screen hang off it. -->
        <activity
            android:name=".ui.AccountActivity"
            android:exported="false"
            android:label="@string/account_title"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ui.OnlineActivity"
            android:exported="false"
            android:label="@string/online_title"
            android:parentActivityName=".ui.AccountActivity" />

        <activity
            android:name=".ui.OnlineGameActivity"
            android:exported="false"
            android:label="@string/online_game_title"
            android:parentActivityName=".ui.OnlineActivity" />

        <activity
            android:name=".ui.OnlineHistoryActivity"
            android:exported="false"
            android:label="@string/online_history"
            android:parentActivityName=".ui.OnlineActivity" />

        <activity
            android:name=".ui.OnlineReplayActivity"
            android:exported="false"
            android:label="@string/online_replay_title"
            android:parentActivityName=".ui.OnlineHistoryActivity" />

        <activity
            android:name=".ui.LeaderboardActivity"
            android:exported="false"
            android:label="@string/online_leaders"
            android:parentActivityName=".ui.OnlineActivity" />
    </application>

</manifest>
