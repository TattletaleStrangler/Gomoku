<?xml version="1.0" encoding="utf-8"?>
<!--
    Languages the app ships. Android 13+ reads this for the per-app language picker in
    the system settings; the in-app picker lives on the settings screen (Locales).
    Every tag here has a values-<tag> directory — LocalizationTest enforces both.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="ru" />
    <locale android:name="uk" />
    <locale android:name="be" />
    <locale android:name="kk" />
    <locale android:name="en" />
    <locale android:name="es" />
    <locale android:name="de" />
    <locale android:name="fi" />
    <locale android:name="hi" />
    <locale android:name="zh" />
    <locale android:name="ja" />
</locale-config>
