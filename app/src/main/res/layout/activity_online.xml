<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onlineRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Top bar: back, title, who is signed in, and the account screen. -->
    <LinearLayout
        android:id="@+id/onlineTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnOnlineBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/online_back"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvOnlineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/online_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOnlineNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnOnlineAccount"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/account_title"
            android:src="@drawable/ic_account" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvOnlineError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Waiting for the opponent: the code is the only thing that matters. -->
            <LinearLayout
                android:id="@+id/groupWaiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvWaitingTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_waiting"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvWaitingCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:letterSpacing="0.25"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWaitingHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/online_waiting_hint"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnCloseRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/online_cancel_room" />
            </LinearLayout>

            <!-- Creating a room, joining by code, or returning to a game in progress. -->
            <LinearLayout
                android:id="@+id/groupForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnResume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_return_to_game"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_history" />

                <TextView
                    android:id="@+id/tvCreateTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/online_create"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRuleTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_rule"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rgRule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbFreestyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/online_rule_freestyle" />

                    <RadioButton
                        android:id="@+id/rbRenju"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/online_rule_renju" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvColorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_play_as"
                    android:textSize="14sp" />

                <!-- Black by default; ANY leaves the choice to the opponent. -->
                <RadioGroup
                    android:id="@+id/rgColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbColorBlack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/play_black" />

                    <RadioButton
                        android:id="@+id/rbColorWhite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/play_white" />

                    <RadioButton
                        android:id="@+id/rbColorAny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/online_color_any" />
                </RadioGroup>

                <TextView
                    android:id="@+id/tvTimeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_time_control"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/rgTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbUntimed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/online_time_untimed" />

                    <RadioButton
                        android:id="@+id/rbClassic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/online_time_classic" />

                    <RadioButton
                        android:id="@+id/rbRapid"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/online_time_rapid" />

                    <RadioButton
                        android:id="@+id/rbBlitz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/online_time_blitz" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnCreate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/online_create_action" />

                <!-- Quick match uses the same rule / clock / colour chosen above. -->
                <Button
                    android:id="@+id/btnQuick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_quick" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvLobbyTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/online_lobby"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnRefreshLobby"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/online_lobby_refresh" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLobbyEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/online_lobby_empty"
                    android:textSize="14sp" />

                <!-- Rows are filled in code from the lobby response. -->
                <LinearLayout
                    android:id="@+id/lobbyList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvJoinTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/online_join"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/online_code"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:maxLength="6" />

                <TextView
                    android:id="@+id/tvJoinColorTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_join_color"
                    android:textSize="14sp" />

                <!-- Honoured only when the room left the colour open; no preference by
                     default. -->
                <RadioGroup
                    android:id="@+id/rgJoinColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbJoinAny"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/online_color_any" />

                    <RadioButton
                        android:id="@+id/rbJoinBlack"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/play_black" />

                    <RadioButton
                        android:id="@+id/rbJoinWhite"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/play_white" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnJoin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/online_join_action" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>